# ─── Supabase Postgres ───────────────────────────────────────────────────────
#
# DATABASE_URL → Session-mode pooler (port 5432) — required for Prisma 6
#   Supabase dashboard → Settings → Database → Connection pooling → Session mode
#   ⚠ Do NOT use port 6543 (transaction mode) — Prisma 6 prepared statements
#     break under PgBouncer transaction mode (error 26000).
#
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# DIRECT_URL → Direct connection — used only by `prisma migrate deploy`
#   Supabase dashboard → Settings → Database → Connection string → URI
#
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Session signing secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# Only used by `npm run seed:owner`, to set the owner account's password.
# Keep these in .env (gitignored), never here.
# OWNER_EMAIL=""
# OWNER_PASSWORD=""
