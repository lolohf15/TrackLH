# ─── Supabase Postgres ───────────────────────────────────────────────────────
#
# DATABASE_URL → Session-mode pooler (port 5432) — required for Prisma 6
#   Supabase dashboard → Settings → Database → Connection pooling → Session mode
#   ⚠ Do NOT use port 6543 (transaction mode) — Prisma 6 prepared statements
#     break under PgBouncer transaction mode (error 26000).
#
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# The app reads DATABASE_URL through node-postgres (lib/prisma.ts) with
# Supabase's root CA pinned. `prisma migrate deploy` still uses Prisma's own
# engine, which can't open TLS to Supabase from macOS 27: apply migrations with
# the Supabase connector and register them in _prisma_migrations.
#
# DIRECT_URL → Direct connection
#   Supabase dashboard → Settings → Database → Connection string → URI
#
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Session signing secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# Sign in with Google. Create an OAuth client in Google Cloud Console
# (APIs & Services → Credentials → OAuth client ID → Web application) and add
# these Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-production-domain>/api/auth/callback/google
# Without them the Google button still shows, but Google refuses the sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only used by `npm run seed:owner`, to set the owner account's password.
# Keep these in .env (gitignored), never here.
# OWNER_EMAIL=""
# OWNER_PASSWORD=""
