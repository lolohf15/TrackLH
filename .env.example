# ─── Supabase Postgres ───────────────────────────────────────────────────────
# Transaction-mode pooler — used by Prisma at runtime (Vercel serverless)
# Find in: Supabase dashboard → Settings → Database → Connection pooling → Transaction mode
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection — used by `prisma migrate deploy` only
# Find in: Supabase dashboard → Settings → Database → Connection string → URI
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.com:5432/postgres"

# ─── Notion ──────────────────────────────────────────────────────────────────
NOTION_API_KEY=""
NOTION_DATABASE_ID=""

# ─── Optional: override Notion property names ────────────────────────────────
# NOTION_PROP_DATE="Fecha"
# NOTION_PROP_AMOUNT="Monto"
# NOTION_PROP_TYPE="Tipo"
# NOTION_PROP_CATEGORY="Categoría"
# NOTION_PROP_ACCOUNT="Cuenta"
# NOTION_PROP_TO_ACCOUNT="Cuenta Destino"
# NOTION_PROP_DESCRIPTION="Descripción"
# NOTION_PROP_PROCESADO="Procesado"
# NOTION_PROP_NOTES="Notas"
