# ─── Supabase Postgres ───────────────────────────────────────────────────────
#
# DATABASE_URL → Session-mode pooler (port 5432) — required for Prisma 6
#   Supabase dashboard → Settings → Database → Connection pooling → Session mode
#   ⚠ Do NOT use port 6543 (transaction mode) — Prisma 6 prepared statements
#     break under PgBouncer transaction mode (error 26000).
#
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# DIRECT_URL → Direct connection — used only by `prisma migrate deploy`
#   Supabase dashboard → Settings → Database → Connection string → URI
#
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ─── Notion ──────────────────────────────────────────────────────────────────
NOTION_API_KEY=""
NOTION_DATABASE_ID=""

# ─── Optional: override Notion property names ────────────────────────────────
# NOTION_PROP_DATE="Fecha"
# NOTION_PROP_AMOUNT="Monto"
# NOTION_PROP_TYPE="Tipo"
# NOTION_PROP_CATEGORY="Categoría"
# NOTION_PROP_ACCOUNT="Cuenta"
# NOTION_PROP_TO_ACCOUNT="Cuenta Destino"
# NOTION_PROP_DESCRIPTION="Descripción"
# NOTION_PROP_PROCESADO="Procesado"
# NOTION_PROP_NOTES="Notas"
