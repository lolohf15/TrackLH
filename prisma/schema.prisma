generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One person's whole ledger. Sessions are JWTs, so there is no adapter
/// table here; adding an OAuth provider later would add its own.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// Null until the owner runs `npm run seed:owner`, or until signup sets it.
  passwordHash String?
  /// Null means the welcome wizard has not been completed yet.
  onboardedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  transactions   Transaction[]
  accountConfigs AccountConfig[]
  budgetConfigs  BudgetConfig[]
  categories     Category[]
}

model Transaction {
  id          String   @id
  /// Carries a database-level DEFAULT pointing at the owner, so the iOS
  /// shortcut can keep inserting rows without knowing about users.
  userId      String
  date        DateTime
  amount      Decimal  @db.Decimal(14, 2)
  type        String
  category    String?
  account     String
  toAccount   String?
  description String?
  notes       String?
  procesado   Boolean  @default(false)
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model SyncLog {
  id       Int      @id @default(autoincrement())
  syncedAt DateTime @default(now())
  status   String
  count    Int      @default(0)
  skipped  Int      @default(0)
  warnings String?
  message  String?
}

model AccountConfig {
  id                 Int       @id @default(autoincrement())
  userId             String
  account            String
  initialBalance     Decimal   @default(0) @db.Decimal(14, 2)
  initialBalanceDate DateTime?
  balanceAdjustment  Decimal   @default(0) @db.Decimal(14, 2)
  adjustmentDate     DateTime?
  isCredit           Boolean   @default(false)
  /// What the account is when it isn't a card: "cash" or "other" (savings,
  /// investments). Null means a card — debit or credit by `isCredit` — which
  /// is how every account read before this existed. Only changes how the
  /// Wallet draws it; balances compute the same either way.
  kind               String?
  /// Left out of the Wallet's deck and pocket to keep it uncluttered. Still
  /// counts in every balance, total and list.
  hiddenInWallet     Boolean   @default(false)
  /// Credit accounts only: the approved line. Null means no line on file — the
  /// account then reads exactly the way it did before limits existed.
  creditLimit        Decimal?  @db.Decimal(14, 2)
  /// Credit accounts only: the cut-off day of the month, 1–31. Days past the
  /// end of a short month fall on its last day. Null means no cycle on file,
  /// and the card reads exactly as it did before cycles existed.
  statementDay       Int?
  /// Credit accounts only: the payment due day, 1–31. Falls in the month after
  /// the cut when it is on or before the statement day.
  dueDay             Int?
  color              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, account])
  @@index([userId])
}

model BudgetConfig {
  id        Int      @id @default(autoincrement())
  userId    String
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

/// Per-user spending and income categories. Replaces the CATEGORY_COLORS /
/// EXPENSE_CATEGORIES / INCOME_CATEGORIES constants, which had no storage.
model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String
  /// A key from CATEGORY_ICON_KEYS in lib/category-icons.ts, never raw SVG.
  /// Null falls back to the name's first letter on a tinted circle.
  icon      String?
  /// "expense" | "income"
  kind      String   @default("expense")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, name])
  @@index([userId])
}
