generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One person's whole ledger. Sessions are JWTs, so there is no adapter
/// table here; adding an OAuth provider later would add its own.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// Null until the owner runs `npm run seed:owner`, or until signup sets it.
  passwordHash String?
  /// Null means the welcome wizard has not been completed yet.
  onboardedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  transactions   Transaction[]
  accountConfigs AccountConfig[]
  budgetConfigs  BudgetConfig[]
  categories     Category[]
}

model Transaction {
  id          String   @id
  /// Carries a database-level DEFAULT pointing at the owner, so the iOS
  /// shortcut can keep inserting rows without knowing about users.
  userId      String
  date        DateTime
  amount      Float
  type        String
  category    String?
  account     String
  toAccount   String?
  description String?
  notes       String?
  procesado   Boolean  @default(false)
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model SyncLog {
  id       Int      @id @default(autoincrement())
  syncedAt DateTime @default(now())
  status   String
  count    Int      @default(0)
  skipped  Int      @default(0)
  warnings String?
  message  String?
}

model AccountConfig {
  id                 Int       @id @default(autoincrement())
  userId             String
  account            String
  initialBalance     Float     @default(0)
  initialBalanceDate DateTime?
  balanceAdjustment  Float     @default(0)
  adjustmentDate     DateTime?
  isCredit           Boolean   @default(false)
  color              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, account])
  @@index([userId])
}

model BudgetConfig {
  id        Int      @id @default(autoincrement())
  userId    String
  category  String
  amount    Float
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

/// Per-user spending and income categories. Replaces the CATEGORY_COLORS /
/// EXPENSE_CATEGORIES / INCOME_CATEGORIES constants, which had no storage.
model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String
  /// "expense" | "income"
  kind      String   @default("expense")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, name])
  @@index([userId])
}
