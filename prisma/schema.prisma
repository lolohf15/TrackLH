generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One person's whole ledger. Sessions are JWTs, so there is no adapter
/// table here; adding an OAuth provider later would add its own.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// Null until the owner runs `npm run seed:owner`, or until signup sets it.
  passwordHash String?
  /// Null means the welcome wizard has not been completed yet.
  onboardedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  transactions   Transaction[]
  accountConfigs AccountConfig[]
  budgetConfigs  BudgetConfig[]
  categories     Category[]
  recurringRules RecurringRule[]
  oauthAccounts  OAuthAccount[]
}

/// One row per outside identity (Google, later maybe Apple) tied to a user.
/// Matching on the provider's own stable id, not the email, means a later
/// email change at Google does not create a second user.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  /// The email the provider reported when the link was made; informational only.
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Transaction {
  id              String    @id
  /// Carries a database-level DEFAULT pointing at the owner, so the iOS
  /// shortcut can keep inserting rows without knowing about users.
  userId          String
  date            DateTime
  amount          Decimal   @db.Decimal(14, 2)
  type            String
  category        String?
  account         String
  toAccount       String?
  description     String?
  notes           String?
  procesado       Boolean   @default(false)
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// The recurring rule this movement was confirmed from. Null for anything
  /// logged by hand or by the iOS shortcut, which never sends it. Deleting the
  /// rule leaves the movement and clears this.
  recurringRuleId String?
  /// Which of the rule's occurrences this movement is, as a UTC-midnight day.
  /// Paired with the rule in a unique index, so one occurrence can never be
  /// logged twice however many times Confirm is tapped.
  occurrenceDate  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@unique([recurringRuleId, occurrenceDate])
  @@index([userId])
  @@index([userId, date])
}

model SyncLog {
  id       Int      @id @default(autoincrement())
  syncedAt DateTime @default(now())
  status   String
  count    Int      @default(0)
  skipped  Int      @default(0)
  warnings String?
  message  String?
}

model AccountConfig {
  id                 Int       @id @default(autoincrement())
  userId             String
  account            String
  initialBalance     Decimal   @default(0) @db.Decimal(14, 2)
  initialBalanceDate DateTime?
  balanceAdjustment  Decimal   @default(0) @db.Decimal(14, 2)
  adjustmentDate     DateTime?
  isCredit           Boolean   @default(false)
  /// What the account is when it isn't a card: "cash" or "other" (savings,
  /// investments). Null means a card — debit or credit by `isCredit` — which
  /// is how every account read before this existed. Only changes how the
  /// Wallet draws it; balances compute the same either way.
  kind               String?
  /// Left out of the Wallet's deck and pocket to keep it uncluttered. Still
  /// counts in every balance, total and list.
  hiddenInWallet     Boolean   @default(false)
  /// Credit accounts only: the approved line. Null means no line on file — the
  /// account then reads exactly the way it did before limits existed.
  creditLimit        Decimal?  @db.Decimal(14, 2)
  /// Credit accounts only: the cut-off day of the month, 1–31. Days past the
  /// end of a short month fall on its last day. Null means no cycle on file,
  /// and the card reads exactly as it did before cycles existed.
  statementDay       Int?
  /// Credit accounts only: the payment due day, 1–31. Falls in the month after
  /// the cut when it is on or before the statement day.
  dueDay             Int?
  color              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, account])
  @@index([userId])
}

model BudgetConfig {
  id        Int      @id @default(autoincrement())
  userId    String
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

/// Per-user spending and income categories. Replaces the CATEGORY_COLORS /
/// EXPENSE_CATEGORIES / INCOME_CATEGORIES constants, which had no storage.
model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String
  /// A key from CATEGORY_ICON_KEYS in lib/category-icons.ts, never raw SVG.
  /// Null falls back to the name's first letter on a tinted circle.
  icon      String?
  /// "expense" | "income"
  kind      String   @default("expense")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, name])
  @@index([userId])
}

/// A movement that repeats: Spotify every month, the gym, rent, an allowance.
/// It never writes to the ledger on its own. Each time it comes due it shows
/// as pending, and only a Confirm turns it into a `Transaction`.
model RecurringRule {
  id          String    @id @default(cuid())
  userId      String
  /// "Gasto" | "Ingreso" | "Transferencia", the same stored values a movement uses.
  type        String
  amount      Decimal   @db.Decimal(14, 2)
  account     String
  toAccount   String?
  category    String?
  description String?
  /// "weekly" | "monthly" | "yearly"
  frequency   String
  /// Every N weeks, months or years. 1 for the usual case.
  interval    Int       @default(1)
  /// The first occurrence, a UTC-midnight day. Every later one is counted from
  /// here rather than from the one before it, so a day-31 rule that clamps to
  /// 28 Feb lands back on the 31st in March.
  anchorDate  DateTime
  /// Monthly and yearly: the day of the month, 1–31, clamped to the last day
  /// of a shorter month. Null for weekly, which follows the anchor's weekday.
  dayOfMonth  Int?
  /// The oldest occurrence not yet confirmed or skipped.
  nextDueDate DateTime
  /// Last day an occurrence may fall on. Null runs until it is paused or deleted.
  endDate     DateTime?
  /// False while paused: a paused rule never shows as pending.
  active      Boolean   @default(true)
  /// The day it was paused, so resuming can tell what came due before the
  /// pause (still owed) from what fell inside it (skipped). Null while active.
  pausedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}
